<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TarefasApp.TarefaEditPage"
             Title="Editar Tarefa"
             BackgroundColor="Black">

    <ScrollView>
        <StackLayout Padding="20" Spacing="15">

            <Label Text="Título da Tarefa" FontAttributes="Bold" TextColor="White" />
            <Entry x:Name="EntryTitulo" Placeholder="Ex: Comprar pão" TextColor="White" PlaceholderColor="Gray" />

            <Label Text="Descrição" FontAttributes="Bold" TextColor="White" />
            <Editor x:Name="EditorDescricao" Placeholder="Detalhes da tarefa..." HeightRequest="100" TextColor="White" PlaceholderColor="Gray" />

            <StackLayout Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                <Switch x:Name="SwitchUsarData" Toggled="OnSwitchDataToggled" ThumbColor="White" OnColor="Green" />
                <Label Text="Definir Data de Criação:" VerticalOptions="Center" TextColor="White" />
            </StackLayout>
            <DatePicker x:Name="DatePickerCriacao" IsEnabled="False" TextColor="White" />

            <Label Text="Prioridade:" FontAttributes="Bold" TextColor="White" Margin="0,10,0,0" />
            <Picker x:Name="PickerPrioridade" TextColor="White" />

            <Button Text="Salvar" Clicked="OnSalvarClicked" BackgroundColor="#2196F3" TextColor="White" Margin="0,20,0,0" FontAttributes="Bold"/>
            <Button Text="Cancelar" Clicked="OnCancelarClicked" BackgroundColor="#333333" TextColor="White" FontAttributes="Bold" />

        </StackLayout>
    </ScrollView>
</ContentPage>