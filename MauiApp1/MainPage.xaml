<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TarefasApp"
             x:Class="TarefasApp.MainPage"
             Title="Minhas Tarefas">

    <ContentPage.Resources>
        <local:PrioridadeToColorConverter x:Key="CorPrioridadeConverter" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Adicionar" Clicked="OnAdicionarClicked" />
    </ContentPage.ToolbarItems>

    <Grid Padding="15">
        <CollectionView x:Name="TarefasCollection" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Grid Margin="0,0,0,10" 
                          Padding="15" 
                          BackgroundColor="{Binding Prioridade, Converter={StaticResource CorPrioridadeConverter}}">

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTarefaTapped" />
                        </Grid.GestureRecognizers>

                        <StackLayout InputTransparent="True">
                            <Label Text="{Binding Titulo}" FontAttributes="Bold" FontSize="18" TextColor="Black" />
                            <Label Text="{Binding Descricao}" TextColor="#444444" FontSize="14" LineBreakMode="TailTruncation" />
                        </StackLayout>
                    </Grid>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>