<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TarefasApp.TarefaDetailPage"
             Title="Detalhes da Tarefa"
             BackgroundColor="Black">

    <StackLayout Padding="20" Spacing="15">
        <Label Text="Título:" FontAttributes="Bold" TextColor="White" />
        <Label x:Name="LblTitulo" FontSize="18" TextColor="White" />

        <Label Text="Descrição:" FontAttributes="Bold" TextColor="White" />
        <Label x:Name="LblDescricao" FontSize="16" TextColor="White" />

        <Label Text="Data de Criação:" FontAttributes="Bold" TextColor="White" />
        <Label x:Name="LblData" FontSize="16" TextColor="White" />

        <Label Text="Prioridade:" FontAttributes="Bold" TextColor="White" />
        <Label x:Name="LblPrioridade" FontSize="16" TextColor="White" />

        <Button Text="Editar" Clicked="OnEditarClicked" BackgroundColor="#2196F3" TextColor="White" Margin="0,20,0,0" FontAttributes="Bold" />
        <Button Text="Excluir" Clicked="OnExcluirClicked" BackgroundColor="#D32F2F" TextColor="White" FontAttributes="Bold" />
    </StackLayout>
</ContentPage>